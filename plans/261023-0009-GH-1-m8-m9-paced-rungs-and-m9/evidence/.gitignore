# Pcaps, large ns-3 traces and raw Influx dumps stay out of git; each evidence
# dir carries a sha256 manifest instead.
*.pcap
*.pcapng
*.pcap.gz
*.tr.gz
*-full-trace*
influx-dump*/
*.lp.gz
# ns-3 trace text files (X2Stats.txt, EnbSchedAllocTraces.txt, ... up to ~50 MB
# each); ns3run-sha256.txt keeps their digests. IPC traces (*.jsonl) are kept.
**/ns3run/*.txt
**/ns3run/**/*.txt
