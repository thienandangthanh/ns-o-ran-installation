+ *   Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307  USA
+ */
+
+#include "lte-pdcp-sn-wrap.h"
+
+#include "ns3/assert.h"
+
+#include <algorithm>
+
+namespace ns3
+{
+
+namespace
+{
+
+/** The number of SN steps from \p from forward to \p to, modulo the SN space. */
+uint32_t
+PdcpSnDistance(uint16_t from, uint16_t to)
+{
+    NS_ASSERT_MSG(from < PDCP_SN_SPACE && to < PDCP_SN_SPACE, "PDCP SN outside the 12-bit space");
+    return (static_cast<uint32_t>(to) + PDCP_SN_SPACE - from) % PDCP_SN_SPACE;
+}
+
+} // namespace
+
+std::vector<uint16_t>
+OrderPdcpSnsByCount(std::vector<uint16_t> sns)
+{
+    std::sort(sns.begin(), sns.end());
+    NS_ASSERT_MSG(std::adjacent_find(sns.begin(), sns.end()) == sns.end(), "duplicate PDCP SN");
+    if (sns.size() < 2)
+    {
+        return sns;
+    }
+    // The gap that closes the circle, from the largest SN round to the smallest, is the
+    // starting candidate; an interior gap replaces it only when strictly wider, so the
+    // ascending order is kept unless the SNs wrap.
+    std::size_t start = 0;
+    uint32_t widestGap = PdcpSnDistance(sns.back(), sns.front());
+    for (std::size_t i = 1; i < sns.size(); i++)
+    {
+        uint32_t gap = PdcpSnDistance(sns[i - 1], sns[i]);
+        if (gap > widestGap)
+        {
+            widestGap = gap;
+            start = i;
+        }
+    }
+    std::rotate(sns.begin(), sns.begin() + start, sns.end());
+    return sns;
+}
+
+bool
+IsPdcpSnInForwardingLookback(uint16_t sn, uint16_t firstForwardedSn)
+{
+    return PdcpSnDistance(sn, firstForwardedSn) <= 2;
+}
+
+} // namespace ns3
