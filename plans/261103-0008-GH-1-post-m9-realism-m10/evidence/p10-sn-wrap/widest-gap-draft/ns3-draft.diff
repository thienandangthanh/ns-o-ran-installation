+/**
+ * \ingroup lte-test
+ * \brief The pdcp-sn-wrap test suite.
+ */
+class PdcpSnWrapTestSuite : public TestSuite
+{
+  public:
+    PdcpSnWrapTestSuite()
+        : TestSuite("pdcp-sn-wrap", UNIT)
+    {
+        // COUNT order across the wrap.
+        AddTestCase(new PdcpSnCountOrderTestCase("COUNT order of SNs 4094, 4095, 0, 1",
+                                                 {0, 4095, 1, 4094},
+                                                 {4094, 4095, 0, 1}),
+                    TestCase::QUICK);
+        AddTestCase(
+            new PdcpSnCountOrderTestCase("COUNT order of SNs 4095, 0", {0, 4095}, {4095, 0}),
+            TestCase::QUICK);
+        // Without a wrap the order is the ascending SN order.
+        AddTestCase(new PdcpSnCountOrderTestCase("no wrap: SNs 10 to 13",
+                                                 {13, 10, 12, 11},
+                                                 {10, 11, 12, 13}),
+                    TestCase::QUICK);
+        AddTestCase(new PdcpSnCountOrderTestCase("no wrap: SNs 4093 to 4095",
+                                                 {4095, 4093, 4094},
+                                                 {4093, 4094, 4095}),
+                    TestCase::QUICK);
+        AddTestCase(new PdcpSnCountOrderTestCase("no wrap: SNs 0 and 2047", {2047, 0}, {0, 2047}),
+                    TestCase::QUICK);
+        AddTestCase(new PdcpSnCountOrderTestCase("no wrap: one SN", {7}, {7}), TestCase::QUICK);
+        AddTestCase(new PdcpSnCountOrderTestCase("no wrap: no SN", {}, {}), TestCase::QUICK);
+
+        // The RLC AM transmitting SDU buffer that the eNB and UE RRC forward at handover.
+        AddTestCase(
+            new RlcAmSduBufferCountOrderTestCase("RLC AM SDU buffer of SNs 4094, 4095, 0, 1",
+                                                 {4094, 4095, 0, 1}),
+            TestCase::QUICK);
+        AddTestCase(
+            new RlcAmSduBufferCountOrderTestCase("no wrap: RLC AM SDU buffer of SNs 10 to 13",
+                                                 {10, 11, 12, 13}),
+            TestCase::QUICK);
+
+        // The previous-SDU lookback of the eNB and UE forwarding buffers.
+        AddTestCase(new PdcpForwardingLookbackTestCase(0, {0, 4094, 4095}), TestCase::QUICK);
+        AddTestCase(new PdcpForwardingLookbackTestCase(1, {0, 1, 4095}), TestCase::QUICK);
+        AddTestCase(new PdcpForwardingLookbackTestCase(2, {0, 1, 2}), TestCase::QUICK);
+        AddTestCase(new PdcpForwardingLookbackTestCase(4095, {4093, 4094, 4095}), TestCase::QUICK);
+    }
+};
+
+/// The static instance that registers the suite.
+static PdcpSnWrapTestSuite g_pdcpSnWrapTestSuite;
