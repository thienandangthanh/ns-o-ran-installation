+
+/**
+ * \file lte-test-pdcp-sn-wrap.cc
+ * \ingroup lte-test
+ *
+ * \brief Tests the lossless-handover forwarding buffer across the 12-bit PDCP SN wrap.
+ *
+ * The SN wraps from 4095 to 0 while COUNT keeps growing, so SDUs with SNs 4094, 4095, 0, 1
+ * were sent in that order. The suite checks that:
+ *  - OrderPdcpSnsByCount puts such SNs in COUNT order and keeps the ascending SN order when
+ *    the SNs do not wrap;
+ *  - the RLC AM transmitting SDU buffer, filled from RLC PDUs by RlcPdusToRlcSdus, is read
+ *    back in COUNT order across the wrap and in SN order without a wrap;
+ *  - IsPdcpSnInForwardingLookback, which both the eNB RRC and the UE RRC call to pick the
+ *    transmitted SDUs that precede the first forwarded SDU, accepts exactly that SN and the
+ *    two SNs before it modulo 4096, including when the first forwarded SN is 0 or 1.
+ */
+
+#include "ns3/lte-pdcp-header.h"
+#include "ns3/lte-pdcp-sn-wrap.h"
+#include "ns3/lte-rlc-am-header.h"
+#include "ns3/lte-rlc-am.h"
+#include "ns3/lte-rlc-sequence-number.h"
+#include "ns3/packet.h"
+#include "ns3/simulator.h"
+#include "ns3/test.h"
+
+#include <sstream>
+#include <string>
+#include <vector>
+
+using namespace ns3;
+
+namespace
+{
+
+std::string
+Join(const std::vector<uint16_t>& values)
+{
+    std::ostringstream out;
+    for (std::size_t i = 0; i < values.size(); i++)
+    {
+        out << (i ? "," : "") << values[i];
+    }
+    return out.str();
+}
+
+/** The payload size of the i-th SDU, distinct per SDU so a swapped packet is detected. */
+uint32_t
+PayloadSize(std::size_t i)
+{
+    return 100 + static_cast<uint32_t>(i);
+}
+
+/**
+ * One RLC AM data PDU that carries exactly one complete PDCP data PDU (framing info: first
+ * and last byte present, no length indicator), as LteRlcAm builds it for transmission.
+ */
+LteRlcAm::RetxPdu
+SingleSduRlcPdu(uint16_t rlcSn, uint16_t pdcpSn, uint32_t payloadSize)
+{
+    Ptr<Packet> pdu = Create<Packet>(payloadSize);
+    LtePdcpHeader pdcpHeader;
+    pdcpHeader.SetDcBit(LtePdcpHeader::DATA_PDU);
+    pdcpHeader.SetSequenceNumber(pdcpSn);
+    pdu->AddHeader(pdcpHeader);
+
+    LteRlcAmHeader rlcHeader;
+    rlcHeader.SetDataPdu();
+    rlcHeader.SetSequenceNumber(SequenceNumber10(rlcSn));
+    rlcHeader.SetResegmentationFlag(LteRlcAmHeader::PDU);
+    rlcHeader.SetLastSegmentFlag(LteRlcAmHeader::LAST_PDU_SEGMENT);
+    rlcHeader.SetSegmentOffset(0);
+    rlcHeader.SetFramingInfo(LteRlcAmHeader::FIRST_BYTE | LteRlcAmHeader::LAST_BYTE);
+    rlcHeader.SetPollingBit(LteRlcAmHeader::STATUS_REPORT_NOT_REQUESTED);
+    rlcHeader.PushExtensionBit(LteRlcAmHeader::DATA_FIELD_FOLLOWS);
+    pdu->AddHeader(rlcHeader);
+
+    LteRlcAm::RetxPdu retxPdu;
+    retxPdu.m_pdu = pdu;
+    retxPdu.m_retxCount = 0;
+    return retxPdu;
+}
+
+} // namespace
+
+/**
+ * \ingroup lte-test
+ * \brief OrderPdcpSnsByCount on one set of SNs, given in a scrambled order.
+ */
+class PdcpSnCountOrderTestCase : public TestCase
+{
+  public:
+    PdcpSnCountOrderTestCase(const std::string& name,
+                             std::vector<uint16_t> input,
+                             std::vector<uint16_t> expected)
+        : TestCase(name),
+          m_input(std::move(input)),
+          m_expected(std::move(expected))
+    {
+    }
+
+  private:
+    void DoRun() override
+    {
+        NS_TEST_ASSERT_MSG_EQ(Join(OrderPdcpSnsByCount(m_input)),
+                              Join(m_expected),
+                              "PDCP SNs in COUNT order");
+    }
+
+    std::vector<uint16_t> m_input;
+    std::vector<uint16_t> m_expected;
+};
+
+/**
+ * \ingroup lte-test
+ * \brief The RLC AM transmitting SDU buffer, filled from single-SDU RLC PDUs in
+ *        transmission order, read back through GetTransmittingRlcSduBuffer.
+ */
+class RlcAmSduBufferCountOrderTestCase : public TestCase
+{
+  public:
+    RlcAmSduBufferCountOrderTestCase(const std::string& name,
+                                     std::vector<uint16_t> pdcpSnsInTxOrder)
+        : TestCase(name),
+          m_pdcpSnsInTxOrder(std::move(pdcpSnsInTxOrder))
+    {
+    }
+
+  private:
+    void DoRun() override
+    {
+        m_rlcAm = CreateObject<LteRlcAm>();
+        std::vector<LteRlcAm::RetxPdu> pdus;
+        for (std::size_t i = 0; i < m_pdcpSnsInTxOrder.size(); i++)
+        {
+            pdus.push_back(
+                SingleSduRlcPdu(static_cast<uint16_t>(i), m_pdcpSnsInTxOrder[i], PayloadSize(i)));
+        }
+        m_rlcAm->RlcPdusToRlcSdus(pdus);
+
+        std::vector<uint16_t> keys;
+        std::vector<uint16_t> headerSns;
+        for (const auto& [sn, sdu] : m_rlcAm->GetTransmittingRlcSduBuffer())
+        {
+            keys.push_back(static_cast<uint16_t>(sn));
+            NS_TEST_ASSERT_MSG_EQ(static_cast<bool>(sdu), true, "every buffered SDU is a packet");
+            LtePdcpHeader pdcpHeader;
+            sdu->PeekHeader(pdcpHeader);
+            headerSns.push_back(pdcpHeader.GetSequenceNumber());
+            // The SDU is the PDCP header plus the payload of the PDU that carried this SN.
+            std::size_t txIndex = 0;
+            while (txIndex < m_pdcpSnsInTxOrder.size() && m_pdcpSnsInTxOrder[txIndex] != sn)
+            {
+                txIndex++;
+            }
+            NS_TEST_ASSERT_MSG_LT(txIndex, m_pdcpSnsInTxOrder.size(), "a transmitted SN");
+            NS_TEST_ASSERT_MSG_EQ(sdu->GetSize(),
+                                  pdcpHeader.GetSerializedSize() + PayloadSize(txIndex),
+                                  "the SDU stored under SN " << sn);
+        }
+        NS_TEST_ASSERT_MSG_EQ(Join(keys),
+                              Join(m_pdcpSnsInTxOrder),
+                              "transmitting SDU buffer in COUNT order");
+        NS_TEST_ASSERT_MSG_EQ(Join(headerSns), Join(keys), "each SDU carries its own SN");
+    }
+
+    void DoTeardown() override
+    {
+        // The RLC entity schedules its buffer-size trace at construction; the simulator never
+        // runs here, so drop that event together with the entity.
+        if (m_rlcAm)
+        {
+            m_rlcAm->Dispose();
+            m_rlcAm = nullptr;
+        }
+        Simulator::Destroy();
+    }
+
+    std::vector<uint16_t> m_pdcpSnsInTxOrder;
+    Ptr<LteRlcAm> m_rlcAm;
+};
+
+/**
+ * \ingroup lte-test
+ * \brief The SNs IsPdcpSnInForwardingLookback accepts for one first forwarded SN, over the
+ *        whole 12-bit SN space.
+ */
+class PdcpForwardingLookbackTestCase : public TestCase
+{
+  public:
+    PdcpForwardingLookbackTestCase(uint16_t firstForwardedSn, std::vector<uint16_t> expected)
+        : TestCase("eNB and UE forwarding lookback at first forwarded SN " +
+                   std::to_string(firstForwardedSn)),
+          m_firstForwardedSn(firstForwardedSn),
+          m_expected(std::move(expected))
+    {
+    }
+
+  private:
+    void DoRun() override
+    {
+        std::vector<uint16_t> accepted;
+        for (uint32_t sn = 0; sn < PDCP_SN_SPACE; sn++)
+        {
+            if (IsPdcpSnInForwardingLookback(static_cast<uint16_t>(sn), m_firstForwardedSn))
+            {
+                accepted.push_back(static_cast<uint16_t>(sn));
+            }
+        }
+        NS_TEST_ASSERT_MSG_EQ(Join(accepted),
+                              Join(m_expected),
+                              "the first forwarded SN and its two predecessors modulo 4096");
+    }
+
+    uint16_t m_firstForwardedSn;
+    std::vector<uint16_t> m_expected;
+};
