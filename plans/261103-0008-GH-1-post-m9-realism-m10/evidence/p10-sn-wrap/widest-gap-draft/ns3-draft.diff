+ */
+
+#ifndef LTE_PDCP_SN_WRAP_H
+#define LTE_PDCP_SN_WRAP_H
+
+#include <cstdint>
+#include <vector>
+
+namespace ns3
+{
+
+/**
+ * The size of the PDCP SN space of the data radio bearers in this module: every DRB PDCP
+ * entity (LtePdcp, McEnbPdcp, McUePdcp) uses a 12-bit SN that wraps from 4095 to 0
+ * (TS 36.323 clause 6.2.3, TS 38.323 clause 6.2.2.2), and LtePdcpHeader carries 12 SN bits.
+ */
+constexpr uint32_t PDCP_SN_SPACE = 4096;
+
+/**
+ * \brief Order PDCP SNs by the COUNT of the SDUs that carry them.
+ *
+ * COUNT is [HFN, SN] and grows without wrapping, while the SN wraps from 4095 to 0, so
+ * SNs {4094, 4095, 0, 1} were assigned in that order. A receiver recovers COUNT from an SN
+ * only within half the SN space of a reference (TS 36.323 clause 5.1.2.1.2 with
+ * Reordering_Window = 2048, clause 7.3; TS 38.323 clause 5.2.2.1 with
+ * Window_Size = 2^(SN size - 1), clause 7.2); SDUs still awaiting delivery confirmation
+ * therefore lie on an arc of the SN circle shorter than half the space. That arc starts
+ * right after the widest gap between neighbouring SNs on the circle, and the result walks
+ * it from there. When the SNs do not wrap and span less than half the space, the widest gap
+ * is the one from the largest SN back round to the smallest, so the result is the ascending
+ * SN order. A tie for the widest gap is broken towards that wrap-round gap, then towards the
+ * gap between the lowest SNs, so the order is total and independent of the input order.
+ *
+ * \param sns distinct PDCP SNs, each below PDCP_SN_SPACE, in any order
+ * \return the same SNs, oldest COUNT first
+ */
+std::vector<uint16_t> OrderPdcpSnsByCount(std::vector<uint16_t> sns);
+
+/**
+ * \brief Whether an already transmitted SDU joins a handover forwarding buffer.
+ *
+ * At a lossless handover the source forwards, ahead of its unacknowledged SDUs, the
+ * transmitted SDUs whose SN is the first forwarded SN or one of the two SNs before it.
+ * "Before" is modulo the SN space, so for a first forwarded SN of 0 the window is
+ * {4094, 4095, 0} and for 1 it is {4095, 0, 1}.
+ *
+ * \param sn the PDCP SN of a transmitted SDU, below PDCP_SN_SPACE
+ * \param firstForwardedSn the PDCP SN at the head of the forwarding buffer, below PDCP_SN_SPACE
+ * \return true iff (firstForwardedSn - sn) modulo PDCP_SN_SPACE is 0, 1 or 2
+ */
+bool IsPdcpSnInForwardingLookback(uint16_t sn, uint16_t firstForwardedSn);
+
+} // namespace ns3
+
+#endif /* LTE_PDCP_SN_WRAP_H */
